{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ipass",
  "main": "src/worker-v20.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/home", "/committee", "/committee.html", "/education", "/education.html", "/ipass", "/ipass/*", "/evaluation-management.html", "/evaluation-cycle.html", "/evaluation-submit.html", "/evaluation-scoring.html"]
  },
  "d1_databases": [
    {
      "binding": "partner_evaluation_db",
      "database_name": "partner-evaluation-db",
      "database_id": "ff99104d-d3b5-4af5-b48e-0a2fbc53564c",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PERFORMANCE_ANALYTICS",
      "dataset": "ipass_performance_v1"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "EVIDENCE_FILES",
      "bucket_name": "ipass-evidence-files"
    }
  ]
}
